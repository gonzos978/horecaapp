// v2
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{path=**}/zones/{zoneId} {
      allow read: if true;
    }

    // -------------------------
    // HELPERS
    // -------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function getUserData() {
      // Try UID-keyed doc first (new workers), fall back to email-keyed doc (old workers/managers)
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }
    function isSuperAdmin() {
      return isSignedIn()
        && getUserData().type == "SUPER_ADMIN";
    }
    function isAdmin() {
      return isSignedIn()
        && (getUserData().role == "admin"
            || getUserData().type == "SUPER_ADMIN");
    }
    function isCustomer() {
      return isSignedIn()
        && getUserData().role == "CUSTOMER";
    }
    function isWorker() {
      return isSignedIn()
        && getUserData().role == "worker";
    }
    function isManagerOrCustomer() {
      return isSignedIn()
        && getUserData().role in ["manager", "MANAGER", "customer", "CUSTOMER"];
    }

    // PDF STORAGE
    match /training-instructions/{document=**} {
      allow read, write: if request.auth != null;
    }

    // =====================================================
    // USERS
    // =====================================================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        (
          // Super admin / platform admin can create anything
          isSuperAdmin()
          ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && (
              // Admin creates customers
              (
                request.resource.data.role == "customer"
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
              )
              ||
              // Customer creates managers
              (
                request.resource.data.role in ["manager", "MANAGER"]
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["customer", "CUSTOMER"]
              )
              ||
              // Manager creates workers
              (
                request.resource.data.role in ["worker", "WORKER"]
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["manager", "MANAGER"]
              )
            )
          )
        );
      allow update: if request.auth != null &&
        (
          request.auth.uid == userId ||
          userId == request.auth.token.email ||
          getUserData().role in ["admin", "manager", "customer", "MANAGER", "CUSTOMER"]
        );
      allow delete: if request.auth != null &&
        getUserData().role in ["admin", "customer", "manager", "CUSTOMER", "MANAGER"];
    }

    // =====================================================
    // CHECKLISTS
    // =====================================================
    match /checklists/{checklistId} {
      allow read, write: if true;

      match /zones/{zoneId} {
        allow read, write: if true;

        match /items/{itemId} {
          allow read, write: if true;
        }
      }
    }

    // =====================================================
    // MENU ITEMS
    // =====================================================
    match /menu_items/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ["worker", "manager", "customer", "admin"];
      allow update: if request.auth != null
        && (
          resource.data.ownerId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            in ["manager", "admin"]
        );
      allow delete: if request.auth != null
        && (
          resource.data.ownerId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            in ["manager", "customer", "admin"]
        );
    }

    // =====================================================
    // WORKING DAYS
    // =====================================================
    match /workingDays/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.email == request.auth.uid
        && (
          request.resource.data.role == "worker"
          || request.resource.data.role == "manager"
        );
      allow update: if request.auth != null
        && resource.data.email == request.auth.uid;
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // =====================================================
    // NOTIFICATIONS
    // =====================================================
    match /notifications/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "customer"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "worker"
        );
      allow update: if request.auth != null
        && resource.data.creatorId == request.auth.uid;
      allow delete: if request.auth != null
        && (
          resource.data.creatorId == request.auth.uid
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "customer"
                || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager")
          )
        );
    }

    // =====================================================
    // MENU
    // =====================================================
    match /menu/{menuId} {
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // =====================================================
    // CUSTOMERS
    // =====================================================
    match /customers/{customerId} {
      allow read: if isSuperAdmin()
                  || (isSignedIn() && getUserData().customerId == customerId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();

      match /managers/{managerId} {
        allow read: if isSuperAdmin()
                    || (isSignedIn() && getUserData().customerId == customerId);
        allow create, update, delete: if isSuperAdmin();
      }
    }

    // =====================================================
    // SHIFTS
    // Workers create/read/update their own shifts.
    // Managers & Customers can read shifts for their company.
    // =====================================================
    match /shifts/{shiftId} {
      allow create: if isSignedIn()
                    && getUserData().role == "worker"
                    && request.resource.data.workerId == request.auth.uid;

      allow read: if isSignedIn()
                  && (
                    resource.data.workerId == request.auth.uid
                    || (isManagerOrCustomer()
                        && resource.data.customerId == getUserData().customerId)
                    || isSuperAdmin()
                  );

      allow update: if isSignedIn()
                    && resource.data.workerId == request.auth.uid;

      // Submitted checklist snapshots
      match /checklists/{checklistId} {
        allow create, update: if isSignedIn()
                      && request.resource.data.workerId == request.auth.uid;

        allow read: if isSignedIn()
                    && (
                      get(/databases/$(database)/documents/shifts/$(shiftId)).data.workerId == request.auth.uid
                      || isManagerOrCustomer()
                      || isSuperAdmin()
                    );
      }

      // Individual actions within a shift
      match /actions/{actionId} {
        allow create: if isSignedIn()
                      && request.resource.data.workerId == request.auth.uid;

        allow read: if isSignedIn()
                    && (
                      resource.data.workerId == request.auth.uid
                      || isManagerOrCustomer()
                      || isSuperAdmin()
                    );
      }
    }

    // =====================================================
    // ANONYMOUS REPORTS
    // Workers can create reports and read only their own.
    // Managers/customers can read all reports for their company.
    // Only managers/customers/admins can update (status, adminNote).
    // =====================================================
    match /anonymous_reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.workerId == request.auth.uid;

      allow read: if isSignedIn()
                  && (
                    resource.data.workerId == request.auth.uid
                    || (isManagerOrCustomer()
                        && resource.data.customerId == getUserData().customerId)
                    || isSuperAdmin()
                  );

      allow update: if isSignedIn()
                    && (
                      isManagerOrCustomer()
                      && resource.data.customerId == getUserData().customerId
                      || isSuperAdmin()
                    );
    }

    // =====================================================
    // DOCUMENTS (public training materials)
    // =====================================================
    match /documents/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // =====================================================
    // TRAINING INSTRUCTIONS (PDFs per customer/worker type)
    // =====================================================
    match /training-instructions/{docId} {
      allow read: if isSignedIn()
                  && (
                    resource.data.customerId == getUserData().customerId
                    || isSuperAdmin()
                  );
      allow create: if isSignedIn() && isManagerOrCustomer();
      allow delete: if isSignedIn() && isManagerOrCustomer()
                    && resource.data.customerId == getUserData().customerId;
    }

    // =====================================================
    // SETTINGS (per-company notification prefs etc.)
    // =====================================================
    match /settings/{customerId} {
      allow read, write: if isSignedIn()
                         && getUserData().customerId == customerId;
    }

    // =====================================================
    // CHAT GROUPS (custom named groups metadata)
    // =====================================================
    match /chat_groups/{groupId} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
                   && request.auth.uid in request.resource.data.memberIds
                   && getUserData().role in ["customer", "CUSTOMER", "manager", "MANAGER"];
      allow update, delete: if isSignedIn()
                            && resource.data.createdBy == request.auth.uid;
    }

    // =====================================================
    // CHATS (group + DMs)
    // All authenticated users in the same company can read/write
    // their own group chat and DMs.
    // =====================================================
    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid;
      }
    }

    // =====================================================
    // GENERATED TESTS
    // =====================================================
    match /generated_tests/{testId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =====================================================
    // QUIZZES (manually created by managers)
    // =====================================================
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // =====================================================
    // ULTIMATE TESTS (created by SuperAdmin)
    // =====================================================
    match /ultimate_tests/{testId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // =====================================================
    // QUIZ RESULTS (worker test performance)
    // =====================================================
    match /quiz_results/{resultId} {
      allow read, write: if isSignedIn();
    }

    // =====================================================
    // REQUESTS (vacation / sick-day requests from workers)
    // Workers can create their own requests and read them.
    // Managers/Customers can read all requests for their company and update (approve/reject).
    // =====================================================
    // =====================================================
    // WORKER NOTIFICATIONS (approval/rejection from manager)
    // =====================================================
    match /workerNotifications/{notifId} {
      // Manager writes notification on decision; workers write when accepting/declining replacement
      allow create: if isSignedIn();

      // Worker reads and marks their own as read
      allow read, update: if isSignedIn()
                          && resource.data.workerId == request.auth.uid;
    }

    match /requests/{requestId} {
      allow create: if isSignedIn()
                    && (
                      request.resource.data.workerId == request.auth.uid
                      || request.resource.data.replacementWorkerId == request.auth.uid
                    );

      allow read: if isSignedIn()
                  && (
                    resource.data.workerId == request.auth.uid
                    || resource.data.replacementWorkerId == request.auth.uid
                    || (isManagerOrCustomer()
                        && resource.data.customerId == getUserData().customerId)
                    || isSuperAdmin()
                  );

      allow update: if isSignedIn()
                    && (
                      // Manager/customer approves or rejects
                      (isManagerOrCustomer()
                       && resource.data.customerId == getUserData().customerId)
                      // Replacement worker accepts/declines their part
                      || resource.data.replacementWorkerId == request.auth.uid
                      || isSuperAdmin()
                    );
    }
  }
}
